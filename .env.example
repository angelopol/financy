# Copy the variables you need into apps/api/.env for local development.
# apps/api/.env.example carries the same list; this root copy exists so the
# monorepo's required configuration is visible from the project root too.

# PostgreSQL connection used by apps/api (Supabase pooler URL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financy

# Public origin of the frontend; also used as the CORS/write-origin allowlist
APP_URL=http://localhost:5173

# Port the NestJS API listens on locally
PORT=3000

# Random string (32+ chars) required in the Authorization header of /api/cron
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters

# Resend used for verification, password reset and recurring-earning reminder emails
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Optional fallback source for official exchange rates
DOLARVZLA_API_KEY=

# Gemini API key powering the Financy IA chat assistant (gemini-3.5-flash-lite)
GEMINI_API_KEY=
