{
  "name": "financy",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "dev:demo": "concurrently -k \"npm run dev:demo -w apps/api\" \"npm run dev -w apps/web\"",
    "test:e2e": "playwright test",
    "format": "prettier --write apps tests docs README.md playwright.config.ts"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^11.2.3",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "multer": "2.3.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "multer": "2.3.0",
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  }
}
